# =====================================================================
#  Mr Sam Tutorial Center — environment variables
#  Copy this file to `.env.local` and fill in real values.
#  Never commit `.env.local` / `.env` (both are gitignored).
# =====================================================================

# ── Database (Neon Postgres) ─────────────────────────────────────────
# POOLED connection string from the Neon dashboard:
#   Neon console → your project → "Connection Details" → pooled branch URL.
# Must include ?sslmode=require. Server-side only — NEVER add NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Neon DIRECT (unpooled) string — used by drizzle-kit (migrations/push/studio).
# Leave empty to fall back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# ── Auth ─────────────────────────────────────────────────────────────
# Long random secret used to sign JWTs. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# Access tokens have NO expiry — revoked centrally via users.token_version
# (password change / suspension), never by age. The refresh token below is
# re-issued silently by proxy.ts whenever the access cookie lapses.
# Refresh token lifetime in days (rolling: session survives inactivity up to this)
JWT_REFRESH_TTL_DAYS="14"
# Names of the httpOnly session cookies (access + refresh)
AUTH_ACCESS_COOKIE="mrsam_access"
AUTH_REFRESH_COOKIE="mrsam_refresh"

# ── App URL ──────────────────────────────────────────────────────────
# Used for absolute links (password reset, emails). No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (Brevo SMTP) — OPTIONAL ────────────────────────────────────
# The app runs fully without SMTP: in dev, emails are logged to the
# server console; in production they are skipped with an audit warning.
# Brevo → Settings → SMTP & API → SMTP tab for host/login/key.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
# Brevo SMTP login (an email address, NOT your Brevo account password)
SMTP_USER=""
# Brevo SMTP key (SMTP tab → "Generate SMTP key")
SMTP_PASS=""
# Must be a sender or domain verified in Brevo
EMAIL_FROM="Mr Sam Tutorial Center <verified-sender@yourdomain.com>"
# Where contact forms / registration requests / trial requests are notified
ADMIN_NOTIFY_EMAIL=""

# ── File uploads (Vercel Blob) — OPTIONAL in local dev ───────────────
# Vercel dashboard → Project → Storage → Blob → connect, then copy the token.
# Without it, upload endpoints fail gracefully in dev.
BLOB_READ_WRITE_TOKEN=""
